{
  "notes": "Motion controller catalog. clip_id → Mixamo source + retargeted Action name on SMPL-X_Armature.",
  "armature": "SMPL-X_Armature",
  "blend_file": "whole_body_retargeted.blend",
  "source_dir": "body_motion/source_fbx",
  "export_dir": "web_viewer/body_assets/animations",
  "clips": {
    "idle": {
      "fbx": "Idle.fbx",
      "action": "idle",
      "layer": "base",
      "loop": true,
      "director": ["idle", "standing"]
    },
    "walk": {
      "fbx": "walk.fbx",
      "action": "walk",
      "layer": "base",
      "loop": true,
      "director": ["walking", "walk"]
    },
    "walk_back": {
      "fbx": "walk_back.fbx",
      "action": "walk_back",
      "layer": "base",
      "loop": true,
      "director": ["walk_back"]
    },
    "run": {
      "fbx": "run.fbx",
      "action": "run",
      "layer": "base",
      "loop": true,
      "director": ["run", "running"]
    },
    "sit_idle": {
      "fbx": "sit_idle.fbx",
      "action": "sit_idle",
      "layer": "base",
      "loop": true,
      "director": ["sitting", "sit"]
    },
    "turn_left": {
      "fbx": "turn_left.fbx",
      "action": "turn_left",
      "layer": "base",
      "loop": false,
      "director": ["turn_left"]
