      "layer": "upper",
      "loop": true,
      "director": ["talk_open"]
    },
    "talk_emphasize": {
      "fbx": "talk_emphasize.fbx",
      "action": "talk_emphasize",
      "layer": "upper",
      "loop": true,
      "director": ["talk_emphasize"]
    },
    "wave": {
      "fbx": "wave.fbx",
      "action": "wave",
      "layer": "upper",
      "loop": false,
      "director": ["wave"]
    },
    "shrug": {
      "fbx": "shrug.fbx",
      "action": "shrug",
      "layer": "upper",
      "loop": false,
      "director": ["shrug"]
    },
    "point": {
      "fbx": "point.fbx",
      "action": "point",
      "layer": "upper",
      "loop": false,
      "director": ["point", "point_forward"]
