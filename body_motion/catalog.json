    "slump": {
      "fbx": "sad idle.fbx",
      "action": "slump",
      "layer": "full",
      "loop": true,
      "director": ["slump", "sad"]
    },
    "bow": {
      "fbx": "Thankful.fbx",
      "action": "bow",
      "layer": "full",
      "loop": false,
      "director": ["bow", "apologetic"]
