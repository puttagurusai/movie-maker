      "fbx": "look_around.fbx",
      "action": "think",
      "layer": "upper",
      "loop": true,
      "director": ["think", "think_chin"],
      "notes": "uses look_around.fbx as thinking/searching upper motion"
    },
    "nod_yes": {
      "fbx": "Head Nod Yes.fbx",
      "action": "nod_yes",
      "layer": "head",
      "loop": false,
      "director": ["nod_yes", "nod"]
    },
    "shake_no": {
      "fbx": "Shaking Head No.fbx",
      "action": "shake_no",
      "layer": "head",
      "loop": false,
      "director": ["shake_no"]
